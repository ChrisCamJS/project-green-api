DB_HOST=localhost
DB_NAME=pantry_ce_show_live
DB_USER=root
DB_PASS=mysql
ALLOWED_ORIGIN=http://localhost:5173

; ==============================================================================
; STRIPE PAYMENT CREDENTIALS (CARD & CRYPTO TOKEN PURCHASES)
; ==============================================================================
; NOTE: Replace the placeholder values below with your actual Stripe keys from:
;       https://dashboard.stripe.com/apikeys
;
; 1. STRIPE_SECRET_KEY: Your secret key (starts with sk_test_... or sk_live_...)
; 2. STRIPE_PUBLISHABLE_KEY: Your publishable key (starts with pk_test_... or pk_live_...)
; 3. STRIPE_WEBHOOK_SECRET: (Optional) Webhook signing secret (starts with whsec_...)
;    if you configure a webhook in Stripe pointing to: https://your-api-domain/payments/webhook
; 4. FRONTEND_URL: The base URL of your React frontend where Stripe redirects after payment
;    (use http://localhost:5173 for local dev, or https://veggievault.chrisandemmashow.com in live)
;
; CRYPTO NOTE: To accept Crypto (USDC / stablecoins) alongside Cards on Stripe Checkout,
;              enable "Crypto" in your Stripe Dashboard under:
;              Settings -> Payment methods -> Crypto
STRIPE_SECRET_KEY="sk_test_REPLACE_WITH_YOUR_STRIPE_SECRET_KEY"
STRIPE_PUBLISHABLE_KEY="pk_test_REPLACE_WITH_YOUR_STRIPE_PUBLISHABLE_KEY"
STRIPE_WEBHOOK_SECRET="whsec_REPLACE_WITH_YOUR_STRIPE_WEBHOOK_SECRET"
FRONTEND_URL="http://localhost:5173"
